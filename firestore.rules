rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Health check / connection test
    match /test/connection {
      allow read: if true;
    }

    // Barber Services catalog - readable by all, writable by authenticated or admin
    match /services/{serviceId} {
      allow read: if true;
      allow write: if true;
    }

    // Subscription Plans - readable by all, writable by admin
    match /plans/{planId} {
      allow read: if true;
      allow write: if true;
    }

    // Availability & InfinitePay Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Absence Days & Holidays
    match /absences/{absenceId} {
      allow read: if true;
      allow write: if true;
    }

    // Bookings (Agendamentos)
    match /bookings/{bookingId} {
      allow read, create, update, delete: if true;
    }

    // Cash Transactions
    match /transactions/{transactionId} {
      allow read, write: if true;
    }

    // User Profiles & isolated user webhook events
    match /users/{userId} {
      allow read, write: if true;

      match /webhook_events/{eventId} {
        allow read, write: if true;
      }
    }

    // InfinitePay Webhook Events (Root & CollectionGroup)
    match /webhook_events/{eventId} {
      allow read, write: if true;
    }
    match /{path=**}/webhook_events/{eventId} {
      allow read, write: if true;
    }
  }
}
